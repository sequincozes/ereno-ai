{
  "action": "create_benign",
  "description": "Generate the benign seed automatically when it is missing",
  "output": {
    "directory": "target/benign_data",
    "formats": ["csv"],
    "filenamePrefix": "benign_data",
    "enableTracking": false
  },
  "generation": {
    "numberOfMessages": 50000,
    "faultProbability": 5,
    "svStrategy": "DECIMATED",
    "svSamplesPerGoose": 80
  },
  "gooseFlow": {
    "goID": "IntLockA",
    "ethSrc": "01:0c:cd:01:2f:80",
    "ethDst": "01:0c:cd:01:2f:81",
    "ethType": "0x88B8",
    "gooseAppid": "0x00003001",
    "TPID": "0x8100",
    "ndsCom": true,
    "test": true,
    "cbstatus": true
  }
}
